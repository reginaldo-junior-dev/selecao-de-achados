# Apenas para desenvolvimento local (profile dev)
# Valores default já estão em application-dev.properties
# Informe apenas o que for diferente dos defaults

DB_HOST=localhost
DB_PORT=5432
DB_NAME=selecao_de_achados
DB_USERNAME=postgres
DB_PASSWORD=

# Credenciais do admin (usado pelo DatabaseSeeder)
# Se vazio, o seed é ignorado (admin nao sera recriado)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=senha-segura-aqui

# JWT (opcional em dev, fallback em application-dev.properties)
# JWT_SECRET=chave-dev-selecao-de-achados-2024
