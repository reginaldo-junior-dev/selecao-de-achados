# Credenciais do banco (usado pelo container postgres e passado pro backend)
POSTGRES_DB=selecao_de_achados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=suasenha

# JWT (obrigatorio - usado pelo backend)
JWT_SECRET=uma-chave-segura-de-pelo-menos-32-caracteres

# Admin inicial (opcional - se vazio o seed e ignorado)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=senha-admin-aqui

# Supabase (necessario para upload de imagens)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_BUCKET_NAME=nome-do-bucket
